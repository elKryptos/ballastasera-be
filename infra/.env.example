# Infraestructura Docker (PostgreSQL + RustFS). Lo usan:
#   docker compose --env-file infra/.env -f infra/docker-compose.yml up -d
# Spring Boot tambien importa este archivo para compartir credenciales.
DB_USERNAME=
DB_PASSWORD=
DB_NAME=

# RustFS (se mapean a RUSTFS_ACCESS_KEY / RUSTFS_SECRET_KEY oficiales)
RUSTFS_USER=
RUSTFS_PASSWORD=
RUSTFS_CONSOLE=true

# Puerto local del backend Spring Boot al que nginx hace proxy_pass.
# Debe coincidir con SERVER_PORT en ballastasera/.env. Por defecto 8080;
# cambialo SOLO aqui (tu .env local) si tienes algo ocupando el 8080.
# BACKEND_PORT=8081
