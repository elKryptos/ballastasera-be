# App Spring Boot. Credenciales de BD y RustFS en infra/.env
DB_URL=jdbc:postgresql://localhost:5432/ballastasera

# Puerto local del backend (por defecto 8080, el que espera nginx en infra/).
# Si tienes algo ocupando el 8080 en tu maquina, cambia SOLO este .env local,
# nunca el valor por defecto de application.properties ni infra/nginx/default.conf.
# SERVER_PORT=8081

# OAuth2 Google, JWT y email (Spring Boot)
CLIENT_ID=
CLIENT_SECRET=
JWT_SECRET=
JWT_EXPIRATION_MS=86400000
LOG_REQUESTS=false
FRONTEND_OAUTH2_REDIRECT_URI=http://localhost:4200/oauth2/callback
RESEND_API_KEY=
RESEND_EMAIL_FROM=
FRONTEND_URL=http://localhost:4200

# Object storage (sin credenciales: estan en infra/.env)
RUSTFS_ENDPOINT=http://localhost:9000
RUSTFS_REGION=us-east-1
RUSTFS_BUCKET=ballastasera-media
RUSTFS_RAW_BUCKET=ballastasera-media-raw
MEDIA_PUBLIC_URL=http://localhost/media
MEDIA_MAX_FILE_SIZE=10MB
