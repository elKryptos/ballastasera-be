# Condivise da Spring Boot e Docker Compose.
DB_URL=jdbc:postgresql://localhost:5432/ballastasera
DB_USERNAME=ballastasera
DB_PASSWORD=changeme
DB_NAME=ballastasera
DB_PORT=5432

# Impostazioni OAuth2, JWT ed email usate da Spring Boot.
CLIENT_ID=
CLIENT_SECRET=
JWT_SECRET=
JWT_EXPIRATION_MS=86400000
LOG_REQUESTS=false
FRONTEND_OAUTH2_REDIRECT_URI=http://localhost:4200/oauth2/callback
RESEND_API_KEY=
RESEND_EMAIL_FROM=
FRONTEND_URL=http://localhost:4200

# RustFS object storage used by Docker and Spring Boot.
RUSTFS_ENDPOINT=http://localhost:9000
RUSTFS_ACCESS_KEY=
RUSTFS_SECRET_KEY=
RUSTFS_REGION=us-east-1
RUSTFS_BUCKET=ballastasera-media
MEDIA_PUBLIC_URL=http://localhost:8081/media
MEDIA_PROXY_PORT=8081
MEDIA_MAX_FILE_SIZE=10MB
